        "color": "$ink",
        "size": 14,
        "font": "sans-serif"
      },
      "hovered": {
        "background": "$glass-hi"
      }
    },
    ".btn": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 14,
      "padding": {
        "top": 8.8,
        "end": 19.2,
        "bottom": 8.8,
        "start": 19.2
      },
      "minHeight": 44,
      "transition": [
        {
          "properties": "transform",
          "duration": 0.12,
          "easing": "ease"
        },
        {
          "properties": "border",
          "duration": 0.12,
          "easing": "ease"
        },
        {
          "properties": "background",
          "duration": 0.12,
          "easing": "ease"
        }
      ],
      "text": {
        "color": "$ink",
        "size": 15.2,
        "font": "sans-serif",
        "letterSpacing": "0.02em",
        "align": "center"
      },
      "hovered": {
        "border": {
          "color": "$accent"
        },
        "translate": {
          "x": 0,
          "y": -1
        }
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "pressed": {
        "translate": {
          "x": 0,
          "y": 0
        }
      },
      "disabled": {
        "opacity": 0.45
      }
    },
    ".btn-primary": {
      "background": {
        "type": "linear",
        "stops": ["$accent-light", "$accent-dark"]
      },
      "border": {
        "color": "#00000000"
      },
      "shadow": {
        "blur": 18,
        "color": "$accent-soft"
      },
      "text": {
        "color": "#1a1208",
        "weight": "700"
      },
      "hovered": {
        "border": {
          "color": "#00000000"
        },
        "shadow": {
          "blur": 26,
          "color": "$accent-soft"
        }
      }
    },
    ".btn-ghost": {
      "background": "#00000000"
    },
    ".btn-danger": {
      "background": "#00000000",
      "border": {
        "color": "#e05d4f99"
