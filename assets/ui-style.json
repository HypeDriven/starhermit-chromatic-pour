        "font": "sans-serif"
      },
      "hovered": {
        "border": {
          "color": "$accent"
        },
        "text": {
          "color": "$ink"
        }
      }
    },
    ".icon-btn": {
      "background": "#00000000",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 6,
        "end": 10,
        "bottom": 6,
        "start": 10
      },
      "minWidth": 44,
      "minHeight": 44,
